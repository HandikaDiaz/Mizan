{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "hardhat.config.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "ignition/**/*.ts",
    // Peta tipe artifact hasil `hardhat compile`. Tanpa ini, hasil baca contract
    // bertipe unknown. Jalankan compile dulu sebelum typecheck.
    "artifacts/**/*.d.ts"
  ]
}
