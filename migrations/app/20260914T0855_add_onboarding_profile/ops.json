    "id": "unique.user.user_username_key",
    "label": "Add unique constraint on \"user\" (username)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "unique",
        "name": "user_username_key",
        "table": "user"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"user_username_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "user_username_key",
          "public",
          "\"public\".\"user\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"user_username_key\"",
        "sql": "ALTER TABLE \"public\".\"user\" ADD CONSTRAINT \"user_username_key\" UNIQUE (\"username\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"user_username_key\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "user_username_key",
          "public",
          "\"public\".\"user\""
        ]
      }
    ]
